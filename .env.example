# Bu dosyayı kopyalayıp adını ".env.local" yap ve gerçek değerleri gir.
# .env.local dosyası GitHub'a asla yüklenmemeli (gitignore içinde zaten hariç tutuldu).

# Claude API anahtarın (console.anthropic.com üzerinden alınır)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Belge Analizi / Sözleşme İnceleme / Dilekçe Sihirbazı için ÜCRETSİZ
# Google Gemini anahtarı (https://aistudio.google.com/app/apikey adresinden,
# kredi kartı gerekmeden alınır)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Veritabanı adresi. Geliştirme için SQLite dosyası:
DATABASE_URL="file:./dev.db"

# NextAuth için rastgele, uzun bir gizli metin (terminalde: openssl rand -base64 32)
NEXTAUTH_SECRET=buraya-uzun-rastgele-bir-metin-yaz
NEXTAUTH_URL=http://localhost:3000
