// Bu dosya veritabanının "planı"dır: hangi tablolar, hangi sütunlar var.
// Geliştirme sırasında SQLite (tek dosya, kurulum gerektirmez) kullanıyoruz.
// Canlıya (production) alırken sadece aşağıdaki provider'ı "postgresql" yapıp
// .env dosyasındaki DATABASE_URL'i gerçek bir Postgres adresine çevirmen yeterli.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  isAdmin      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  messages     Message[]
  clients      Client[]
  tasks        Task[]
  notes        Note[]
  transactions Transaction[]
  templates    Template[]
}

model Message {
  id        String   @id @default(cuid())
  role      String   // "user" ya da "assistant"
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

model Client {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String?
  notes     String?   // genel not (dava konusu vb.)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  logs      ClientLog[]
  invoices  Invoice[]
  events    ClientEvent[]
}

// "Ne zaman ne konuşmuşuz" — görüşme / iletişim kaydı
model ClientLog {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
}

model Invoice {
  id        String   @id @default(cuid())
  amount    Float
  note      String?
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
}

// Duruşma tarihi ya da ödeme tarihi — takvime düşen ve bildirim üreten kayıt
model ClientEvent {
  id        String   @id @default(cuid())
  type      String   // "durusma" | "odeme" | "gorusme" | "arabuluculuk" | "istinaf" | "temyiz" | özel metin
  title     String
  dueDate   DateTime
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
}

// Bürodaki genel (müvekkilden bağımsız) yapılacaklar listesi
model Task {
  id        String    @id @default(cuid())
  title     String
  done      Boolean   @default(false)
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

// Bürodaki genel (müvekkilden bağımsız) notlar/hatırlatıcılar
model Note {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

// Gelir-gider takibi (büronun genel kasası — kira, personel, aidat vb.
// giderler ve gelen tüm gelirler; müvekkil faturalarından bağımsız)
model Transaction {
  id          String   @id @default(cuid())
  type        String   // "gelir" | "gider"
  amount      Float
  description String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
}

// Şablon kütüphanesi — sadece metin (dosya değil), sık kullanılan
// dilekçe/ihtarname vb. taslak metinleri saklamak için
model Template {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}
