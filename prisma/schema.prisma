// Bu dosya veritabanının "planı"dır: hangi tablolar, hangi sütunlar var.
// Geliştirme sırasında SQLite (tek dosya, kurulum gerektirmez) kullanıyoruz.
// Canlıya (production) alırken sadece aşağıdaki provider'ı "postgresql" yapıp
// .env dosyasındaki DATABASE_URL'i gerçek bir Postgres adresine çevirmen yeterli.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  phone        String?
  baro         String?
  sicilNo      String?
  approved     Boolean   @default(true)
  suspended    Boolean   @default(false) // yönetici tarafından geçici olarak girişi engellenmiş mi (ör. ödeme yapılmadı)
  isAdmin      Boolean   @default(false)
  isDemo       Boolean   @default(false) // true ise: bu bir demo hesabı — hiçbir yazma/AI işlemi yapamaz, sadece gezinebilir
  notifPrefs   Json?
  kvkkChecklist Json?
  homeStatsPrefs Json?
  homeWidgetPrefs Json? // ana sayfada hangi ek widget'ların (Bekleyen Alacaklar, Hızlı Erişim, Bugün, Son Müvekkil Aktivitesi) gösterileceği
  tevkilAlmaAcik Boolean @default(false) // açıksa, sistemdeki HERKESİN tevkil taleplerinden bildirim alır (büro sınırı yok)
  tevkilTalepleri TevkilTalebi[] @relation("TevkilRequester")
  tevkilKabuller  TevkilTalebi[] @relation("TevkilAcceptor")
  tevkilBasvurular TevkilBasvuru[] @relation("TevkilBasvuran")
  createdAt    DateTime  @default(now())
  messages     Message[]
  clients      Client[] // ESKİ ilişki — göç sonrası kullanılmayacak ama veri kaybı olmasın diye duruyor
  tasks        Task[]
  notes        Note[]
  transactions Transaction[]
  templates    Template[]
  readNotifs   NotificationRead[]
  syncToken    String?   @unique
  importBatches ImportBatch[]
  contracts    Contract[]
  savedItems   SavedItem[]
  supportTickets SupportTicket[]
  // ── Büro (Workspace) — Ekip Yönetimi ──
  workspace    Workspace? @relation(fields: [workspaceId], references: [id])
  workspaceId  String?
  workspaceRole String   @default("admin") // "admin" | "member"
  // ── Erişim İzinleri ── yönetici, üyelerin hangi araçları/AI'ı
  // kullanamayacağını belirleyebilir. Varsayılan: her şey açık.
  // blockedTools: kapatılmış araç id'lerinin listesi (ör. ["gelirgider","notlar"])
  blockedTools Json?
  aiEnabled    Boolean  @default(true)
  restrictToOwnItems Boolean @default(false) // açıksa: sadece kendine atanmış dosya/görevleri görür (birden fazla kullanıcılı bürolarda)
  assignedCases Case[] @relation("CaseAssignee")
  assignedTasks Task[] @relation("TaskAssignee")
  // ── Talya Asistan (Telegram Botu) ──
  telegramChatId     String?   @unique
  telegramLinkCode   String?
  telegramLinkCodeExpiry DateTime?
  telegramDailyTime  String?   // "08:00" gibi — her gün bu saatte otomatik gündem gönderilir
  telegramLastSentDate String? // "2026-07-15" — aynı gün içinde iki kez göndermemek için
  // ── Arabuluculuk profili (bir kez ayarlanır, her belgede tekrar yazılmaz) ──
  arabuluculukBurosu String?
  arabulucuSicilNo   String?
  arabulucuUets      String?
  arabulucuAdres     String?
  arabulucuIban      String? // Anlaşma/Kısmi Anlaşma son tutanaklarında ücret cümlesinde otomatik kullanılır — her belgede elle yazılmaz
  officeAddress      String? // genel büro adresi (Avukatlık Ücret Sözleşmesi gibi belgeler için)
  mediationCases     MediationCase[]
}

// Büro (Workspace) — birden fazla kullanıcının aynı müvekkil/dosya
// verisini paylaştığı çalışma alanı. Her yeni kayıt olan kullanıcı
// otomatik olarak kendi (tek kişilik) bürosunu alır; isterse başkalarını
// davet edip büyütebilir.
model Workspace {
  id          String   @id @default(cuid())
  name        String
  memberLimit Int      @default(5)
  createdAt   DateTime @default(now())
  members     User[]
  clients     Client[]
  invites     WorkspaceInvite[]
  tasks       Task[]
  notes       Note[]
  transactions Transaction[]
  templates   Template[]
  contracts   Contract[]
}

// Davet bağlantısı — tek kullanımlık token, /davet/[token] sayfasında
// açılır, kabul edilince kullanıcı bu büroya üye olur.
model WorkspaceInvite {
  id          String    @id @default(cuid())
  token       String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  createdAt   DateTime  @default(now())
  usedAt      DateTime?
  usedByEmail String?
}

// Chrome eklentisinin UYAP'tan okuduğu ham metni Claude'a gönderip
// ayrıştırdıktan sonra oluşan "onay bekleyen" içe aktarım kaydı.
// Kullanıcı Talya'da bu kaydı görüp onaylayana kadar hiçbir şey
// müvekkil/dosya/tarih olarak kaydedilmez.
model ImportBatch {
  id        String   @id @default(cuid())
  source    String   @default("uyap-extension")
  rawText   String
  items     Json     // Claude'un çıkardığı yapılandırılmış öğeler
  status    String   @default("pending") // "pending" | "confirmed" | "dismissed"
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

// Bir bildirimin (duruşma/ödeme/görev tarihinin) okundu olarak işaretlenmesi.
// notifId, /api/notifications'ın ürettiği "ev-xxx" veya "task-xxx" kimliğidir.
model NotificationRead {
  id        String   @id @default(cuid())
  notifId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([userId, notifId])
}

model Message {
  id        String   @id @default(cuid())
  role      String   // "user" ya da "assistant"
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

model Client {
  id          String    @id @default(cuid())
  name        String
  phone       String?
  email       String?
  notes       String?   // genel not (dava konusu vb.)
  tcMersis    String?   // TC Kimlik No / Mersis No
  address     String?   // Tebligat Adresi (Avukatlık Ücret Sözleşmesi için)
  archived    Boolean   @default(false)
  isAday      Boolean   @default(false) // true ise: henüz anlaşılmamış "müvekkil adayı" — normal müvekkil listesinden ayrı gösterilir
  portalPasswordHash String? // müvekkil paneli girişi için (TC No + bu şifre)
  createdAt   DateTime  @default(now())
  // ── GÖÇ NOTU: workspaceId yeni sistem, userId eski sistem ──
  // Veri kaybı olmasın diye ikisini de bir arada tutuyoruz. Bir
  // göç script'i userId'den workspaceId'yi dolduracak. Sonra (ayrı bir
  // adımda) userId tamamen kaldırılacak.
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String?
  logs        ClientLog[]
  cases       Case[]
  messages    ClientPortalMessage[]
  feeAgreements FeeAgreement[]
}

// Müvekkil Paneli üzerinden müvekkil ile büro arasındaki yazışma
// Avukatlık Ücret Sözleşmesi — bir müvekkille yapılan ücret anlaşması.
model FeeAgreement {
  id             String   @id @default(cuid())
  konu           String?  @db.Text // Sözleşme Konusu İş
  sabitUcret     Float?
  yuzdeVarMi     Boolean  @default(false)
  yuzdeOrani     Float?   // dava değeri üzerinden % oranı
  odemeSekli     String   @default("pesin") // "pesin" | "taksit" | "pesin_taksit"
  pesinTarihi    DateTime? // "pesin" modunda tüm ücretin, "pesin_taksit" modunda peşinatın tarihi
  pesinatTutar   Float?    // "pesin_taksit" modunda peşin ödenecek kısmın tutarı
  taksitler      Json?    // [{ tutar: number, tarih: "GG.AA.YYYY" }] — taksitli/peşinat+taksitli ise
  harcMasrafDahil Boolean @default(true) // "Dava harç, masraf vb. giderler iş sahibine aittir." cümlesi eklensin mi
  yetkiYeri      String?  // "Antalya" gibi — uyuşmazlık çözüm yeri maddesinde kullanılır
  sozlesmeTarihi DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId       String
  case           Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  caseId         String?  // bağlıysa: bu dosyanın "Anlaşılan Ücret"i ve vade tarihi buradan otomatik senkronize edilir
  payments       FeeAgreementPayment[]
}

// Bir ücret sözleşmesindeki HER BİR ödeme (peşin tek ödeme, ya da her
// taksit ayrı ayrı) — takvim/bildirim, ödendi işaretleme ve Bekleyen
// Alacaklar entegrasyonu için.
model FeeAgreementPayment {
  id          String   @id @default(cuid())
  tutar       Float
  vadeTarihi  DateTime
  odendiMi    Boolean  @default(false)
  odemeTarihi DateTime? // gerçekte ne zaman ödendiği (Gelir-Gider'e işlendiği an)
  createdAt   DateTime @default(now())
  agreement   FeeAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  agreementId String
  invoice     Invoice?
}

// Tevkil Menüsü — büro sınırı olmadan, SİSTEMDEKİ TÜM avukatlar arasında
// çalışan bir talep/başvuru/onay panosu (ör. "Ankara'da X tarihinde beni
// temsil edecek biri lazım"). "Tevkil Alma" açık olan herkese bildirim
// gider; birden fazla kişi BAŞVURABİLİR, talep sahibi birini ONAYLAR,
// onaylanan kişi sonradan vazgeçerse talep otomatik yeniden AÇILIR.
model TevkilTalebi {
  id            String   @id @default(cuid())
  sehir         String?
  mahkeme       String?
  tarih         DateTime?
  durusmaTuru   String?
  ucretTeklifi  String?
  aciklama      String?  @db.Text
  telefon       String?  // talep sahibinin iletişim bilgisi — SADECE onaylanan kişiye gösterilir
  durum         String   @default("acik") // "acik" | "onaylandi"
  createdAt     DateTime @default(now())
  requesterId   String
  requester     User     @relation("TevkilRequester", fields: [requesterId], references: [id])
  acceptedById  String?  // durum="onaylandi" iken, onaylanan kişi
  acceptedBy    User?    @relation("TevkilAcceptor", fields: [acceptedById], references: [id])
  acceptedAt    DateTime?
  basvurular    TevkilBasvuru[]
}

// Bir tevkil talebine yapılan TEK bir başvuru.
model TevkilBasvuru {
  id          String   @id @default(cuid())
  durum       String   @default("bekliyor") // "bekliyor" | "onaylandi" | "reddedildi" | "iptal_edildi"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  talep       TevkilTalebi @relation(fields: [talepId], references: [id], onDelete: Cascade)
  talepId     String
  applicantId String
  applicant   User     @relation("TevkilBasvuran", fields: [applicantId], references: [id])
}

model ClientPortalMessage {
  id           String   @id @default(cuid())
  content      String
  isFromClient Boolean  @default(true) // müvekkil mi yazdı, büro mu
  isRead       Boolean  @default(false) // büro bu mesajı gördü mü (sadece müvekkil mesajları için anlamlı)
  createdAt    DateTime @default(now())
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId     String
}

// "Ne zaman ne konuşmuşuz" — müvekkille genel görüşme / iletişim kaydı
model ClientLog {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
}

// Bir müvekkilin birden fazla dosyası/davası olabilir — her dosyanın
// kendi tarihleri, faturaları ve zaman kayıtları vardır.
model Case {
  id         String    @id @default(cuid())
  title      String    // ör. "Boşanma Davası", "Tazminat Davası"
  caseNumber String?   // "2026/1329" gibi — dava açıldıktan/UYAP'a düştükten sonra sonradan da girilebilir
  status     String    @default("acik") // "acik" | "kapali"
  agreedFee  Float?    // müvekkille anlaşılan toplam ücret (varsa)
  paymentDueDate DateTime? // ücretin vade tarihi (varsa) — Bekleyen Alacaklar'da "vadesi geçmiş/gelmemiş" ayrımı için
  createdAt  DateTime  @default(now())
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId   String
  assignedTo   User?   @relation("CaseAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String? // sorumlu avukat (birden fazla kullanıcılı bürolarda)
  events     ClientEvent[]
  invoices   Invoice[]
  timeEntries TimeEntry[]
  feeAgreements FeeAgreement[]
}

model Invoice {
  id        String   @id @default(cuid())
  amount    Float
  note      String?
  createdAt DateTime @default(now())
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId    String
  feeAgreementPayment   FeeAgreementPayment? @relation(fields: [feeAgreementPaymentId], references: [id], onDelete: Cascade)
  feeAgreementPaymentId String? @unique // Ücret Sözleşmesi'ndeki bir taksitten otomatik oluştuysa — sözleşme/taksit silinince bu fatura da silinir
}

// Duruşma tarihi ya da ödeme tarihi — takvime düşen ve bildirim üreten kayıt
model ClientEvent {
  id        String   @id @default(cuid())
  type      String   // "durusma" | "odeme" | "gorusme" | "arabuluculuk" | "istinaf" | "temyiz" | özel metin
  title     String
  dueDate   DateTime
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId    String
}

// Zaman takibi — bir dosyaya harcanan süre (saatlik ücretlendirme için)
model TimeEntry {
  id          String   @id @default(cuid())
  hours       Float
  hourlyRate  Float?
  description String?
  date        DateTime @default(now())
  invoiced    Boolean  @default(false)
  createdAt   DateTime @default(now())
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId      String
}

// Bürodaki genel (müvekkilden bağımsız) yapılacaklar listesi
model Task {
  id          String    @id @default(cuid())
  title       String
  done        Boolean   @default(false)
  status      String    @default("yapilacak") // "yapilacak" | "devam" | "tamamlandi" — Kanban sütunu
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  assignedTo   User?   @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String? // görev kime atandı (birden fazla kullanıcılı bürolarda)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String?
}

// Bürodaki genel (müvekkilden bağımsız) notlar/hatırlatıcılar
model Note {
  id          String   @id @default(cuid())
  content     String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String?
}

// Gelir-gider takibi (büronun genel kasası — kira, personel, aidat vb.
// giderler ve gelen tüm gelirler; müvekkil faturalarından bağımsız)
model Transaction {
  id            String   @id @default(cuid())
  type          String   // "gelir" | "gider"
  amount        Float
  description   String
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId   String?
  sourceInvoiceId String? // otomatik oluşan fatura gelirleri için bağlantı
}

// Şablon kütüphanesi — sadece metin (dosya değil), sık kullanılan
// dilekçe/ihtarname vb. taslak metinleri saklamak için
model Template {
  id          String   @id @default(cuid())
  title       String
  content     String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String?
}

// Kütüphanem — Mevzuat Arama'da bulunan bir maddeyi/kararı kaydedip
// sonra tekrar aramadan bulabilme.
model SavedItem {
  id        String   @id @default(cuid())
  type      String   // "mevzuat"
  title     String
  content   String   // kaydedilen tam metin
  sourceRef String?  // ör. mevzuat adı, madde no
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

// Kullanıcıların sorun/öneri bildirdiği destek talepleri
model SupportTicket {
  id        String   @id @default(cuid())
  subject   String
  status    String   @default("acik") // "acik" | "inceleniyor" | "cozuldu"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  messages  SupportMessage[]
}

model SupportMessage {
  id        String   @id @default(cuid())
  content   String
  isAdmin   Boolean  @default(false) // yönetici mi yazdı, kullanıcı mı
  createdAt DateTime @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
}

// Arabuluculuk Dosyası — Davet Mektubu, İlk Oturum ve Son Tutanak
// belgelerinin üretiminde kullanılan, bir kez doldurulup tekrar tekrar
// kullanılan dosya bilgileri.
model MediationCase {
  id                    String   @id @default(cuid())
  durum                 String   @default("acik") // "acik" | "kapali" — sürükle-bırakla değiştirilir
  dosyaNo               String?  // Arabuluculuk Bilgi Sistemi (UYAP) dosya numarası
  buroDosyaNo           String?  // büronun kendi iç dosya numarası — UYAP numarasından ayrı, opsiyonel
  basvurucuTip          String   @default("sahis") // "sahis" | "tuzel"
  basvurucuAd           String?  // şahıs ise Ad Soyad, tüzel ise Unvan
  basvurucuTC           String?  // şahıs ise TC Kimlik No
  basvurucuVergiMersis  String?  // tüzel ise Vergi/Mersis No
  basvurucuYetkiliAd    String?  // tüzel ise Şirket Yetkilisi
  basvurucuAdres        String?
  basvurucuVekilAd      String?
  basvurucuBaroSicil    String?
  basvurucuTelefon      String?
  uyusmazlikKonusu      String?  @db.Text
  uyusmazlikTuru        String?  // "İş Hukuku" | "Ticaret Hukuku" | ... | serbest metin (Diğer seçilirse)
  basvuruTarihi         String?  // "12.03.2026" formatında serbest metin
  gorevlendirmeTarihi   String?
  ilkOturumTarihi       DateTime? // Bilgilendirme ve İlk Oturum toplantı tarihi — takvimle senkronize
  sonTutanakTarihi      DateTime? // Son Tutanak (Anlaşma/Anlaşamama) tarihi — takvimle senkronize
  sonTutanakSonucu      String?   // "anlasma" | "anlasamama" — takvimde doğru etiket için
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String
  karsiTaraflar         MediationParty[]
}

// Karşı taraf sayısı birden fazla olabildiği için (ör. 2-3 farklı kişi/
// şirket), her karşı taraf ayrı bir satır olarak tutulur.
model MediationParty {
  id           String   @id @default(cuid())
  tip          String   @default("sahis") // "sahis" | "tuzel"
  ad           String?  // şahıs ise Ad Soyad, tüzel ise Unvan
  tcKimlik     String?  // şahıs ise TC Kimlik No
  adres        String?
  vergiMersis  String?  // tüzel kişi ise vergi/mersis no
  yetkiliAd    String?  // tüzel kişi ise şirket yetkilisi
  vekilAd      String?  // varsa vekili
  vekilBaroSicil String? // vekilin baro/sicil numarası
  telefon      String?
  sira         Int      @default(0)
  case         MediationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId       String
}

// Sözleşme Takip — bitiş/yenileme tarihi yaklaşan sözleşmeleri takip eder.
model Contract {
  id           String    @id @default(cuid())
  title        String    // ör. "Ofis Kira Sözleşmesi"
  counterparty String?   // karşı taraf
  startDate    DateTime?
  endDate      DateTime
  notes        String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId  String?
}

// Sık değişen hukuki sabitler (kıdem tavanı, yasal faiz oranı, kira TÜFE
// oranı). Tek satırlık bir tablo — yönetici panelinden güncellenir,
// tüm hesaplama araçları buradan okur. Kod değişikliği gerekmez.
model LegalConstants {
  id              String   @id @default("singleton")
  kidemTavani     Float    @default(73729.84)
  faizOrani       Float    @default(24)
  kiraTufeOrani   Float    @default(32.03)
  updatedAt       DateTime @updatedAt
}
